{
  "name": "predictions-sports-prime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run match-routes:sync && npm run match-content:build",
    "match-routes:sync": "tsx scripts/sync-match-routes.mts",
    "build": "next build",
    "fixtures:sync": "tsx scripts/sync-fixtures.mjs",
    "fixtures:validate": "tsx scripts/validate-fixture-snapshot.mjs",
    "test:fixture-sync": "tsx scripts/test-fixture-sync.mts",
    "test:football-results": "tsx scripts/test-football-results.mts",
    "test:site-analytics": "tsx scripts/test-site-analytics.mts",
    "results:settle": "tsx scripts/settle-football-results.mts",
    "results:validate": "tsx scripts/validate-football-results.mts",
    "results:update": "npm run fixtures:sync && npm run results:settle && npm run results:validate",
    "nfl:standings:sync": "tsx scripts/sync-nfl-standings.mjs",
    "audit:nfl-standings": "tsx scripts/audit-nfl-standings.mjs",
    "audit:publication-content": "node --import tsx scripts/audit-publication-content.mjs",
    "audit:psp-editorial-standard": "node --import tsx scripts/audit-psp-editorial-standard.mjs",
    "check-vip-leak": "node scripts/check-vip-leak.mjs",
    "audit:production-integrity": "node scripts/audit-production-integrity.mjs",
    "audit:seo": "tsx scripts/audit-seo.mjs",
    "audit:editorial-quality": "tsx scripts/audit-editorial-quality.mjs",
    "audit:content-similarity": "node --import tsx scripts/audit-content-similarity.mjs",
    "audit:prediction-integrity": "node scripts/audit-prediction-integrity.mjs",
    "audit:international-seo": "node scripts/audit-international-seo.mjs",
    "audit:structured-data": "node scripts/audit-structured-data.mjs",
    "audit:site-links": "node scripts/audit-site-links.mjs",
    "check:editorial-language": "node --import tsx scripts/check-editorial-language.mjs",
    "validate:source": "npm run typecheck",
    "validate:production": "npm run typecheck && npm run build",
    "match-content:build": "tsx scripts/build-match-content.mts"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.5",
    "@supabase/supabase-js": "^2.117.2",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "^4.23.12",
    "typescript": "latest"
  }
}
