# SITE
NEXT_PUBLIC_SITE_URL=

# CONTACT
NEXT_PUBLIC_CONTACT_EMAIL=

# SUPABASE AUTH (public browser credentials)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ADS
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Enable only after configuring the Google-certified CMP in production.
NEXT_PUBLIC_ADSENSE_CMP_READY=false

NEXT_PUBLIC_ADSENSE_SLOT_HOME_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=

NEXT_PUBLIC_ADSENSE_SLOT_LEAGUE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_LEAGUE_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_LEAGUE_MIDDLE=

NEXT_PUBLIC_ADSENSE_SLOT_MATCH_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MATCH_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_MATCH_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BEFORE_TODAY=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BEFORE_TOMORROW=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_UPCOMING=
THESPORTSDB_API_KEY=123

# SERVER-ONLY (Cloudflare Pages Functions). Never prefix with NEXT_PUBLIC_, never commit values.
# Set in the Cloudflare Pages environment, not in the browser bundle.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID=

# GOOGLE PLAY BILLING (Android app). Server-only - see GOOGLE_PLAY_SETUP.md for how each
# of these is created. Never prefix with NEXT_PUBLIC_, never commit values.
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=
# Audience string Google's Pub/Sub push OIDC token must carry (the push endpoint URL),
# and the service account email configured on the Pub/Sub push subscription.
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
